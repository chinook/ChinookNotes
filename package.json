{
  "name": "chinooknotes",
  "version": "0.1.0",
  "description": "Application de documentation (style Notion) pour le projet Chinook de l'ÉTS.",
  "main": "main.js",
  "build": {
    "appId": "ca.ets.chinook.notes",
    "productName": "ChinookNotes",
    "files": [
      "main.js",
      "db.js",
      "preload.js",
      "dist/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName} Setup ${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "ChinookNotes"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NOTES_DEV=1 electron .\"",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "vite build && electron-builder"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-details": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-mathematics": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/html": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "emojibase-data": "^18.0.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "marked": "^18.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "author": "Club Chinook ÉTS"
}
